# 本番では両方を設定する。未設定かつ development のときだけデモモードになる。
# NEXT_PUBLIC_SUPABASE_ANON_KEY には anon key か publishable key（sb_publishable_）を入れる。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバ専用。NEXT_PUBLIC_ は付けない。ブラウザへ出さない。
# 毎日のバックアップが全件を読むときに使う。画面操作では使わない。
SUPABASE_SERVICE_ROLE_KEY=

# バックアップメール。値は本番の環境変数にだけ置く。
GMAIL_USER=
GMAIL_APP_PASSWORD=
BACKUP_TO=
CRON_SECRET=

# development で Supabase を使うときは false。本番では true でもデモにならない。
DEMO_MODE=

# 任意。未指定時、開発中は Downloads の元Excelを探す。
EXCEL_IMPORT_PATH=
